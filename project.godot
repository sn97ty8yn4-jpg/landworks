; Durham Park Sandbox (Landworks machinery sandbox) — Godot 4.6.3, Jolt 120 Hz.
config_version=5

[application]
config/name="Landworks Machinery Sandbox"
run/main_scene="res://landworks/scenes/sandbox_world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/size/mode=3

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[physics/3d]
default_gravity=9.81

[physics/jolt_physics_3d]

; A chain of heavy bodies on powered pins needs more solver work than the
; defaults of 10 velocity and 2 position steps. At the defaults the bucket
; pin separated 204 mm in clear air at the extremes of its travel, which is
; what "the arm breaks when used" looks like; at these settings it is 66 mm.
; The position steps are what hold the chain together - raising the velocity
; steps alone changed nothing.
simulation/velocity_steps=16
simulation/position_steps=8
